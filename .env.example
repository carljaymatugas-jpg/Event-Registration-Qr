PORT=3000
# Replace placeholders before deploying! Production refuses startup if left as 'change-me'.
SESSION_SECRET=change-me
# Database: Neon PostgreSQL connection string (or comment out to use local SQLite)
DATABASE_URL=postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DB_PATH=./data/eventreg.db
# Email (SMTP/Mailtrap sandbox, Resend API, or leave as change-me for local Ethereal sandbox)
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587
MAIL_USER=change-me
MAIL_PASS=change-me
MAIL_FROM="EventReg <no-reply@eventreg.local>"
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USER=change-me
MAILTRAP_PASS=change-me
RESEND_API_KEY=change-me
# HMAC secret for secure QR tokens (must change in production)
TICKET_HMAC_SECRET=change-me
# Seed staff passwords (demo defaults shown — MUST change before production seed)
SEED_ORGANIZER_PASSWORD=organizer123
SEED_DOOR_PASSWORD=door123
# App base URL (required for email links and camera HTTPS)
APP_URL=http://localhost:3000
